# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Spotify — create an app at https://developer.spotify.com/dashboard
# (Client Credentials flow; no redirect URI needed for public artist data)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
# Optional: leave blank to skip YouTube stats.
YOUTUBE_API_KEY=

# Optional: protects POST /api/refresh in production. If blank, refresh is
# allowed from localhost only (fine for local dev).
ADMIN_TOKEN=

# Kit newsletter (kit.com). Signup form adds emails to your Kit list.
KIT_API_KEY=
KIT_FORM_ID=

# Email you on each new signup (resend.com, free). NOTIFY_EMAIL must be the
# address your Resend account uses, unless you verify a domain there.
RESEND_API_KEY=
NOTIFY_EMAIL=

# Optional: Postgres (e.g. free Neon) so stats history survives redeploys.
# Only used on Render (or with USE_LIVE_DB=1); locally the data.db SQLite
# file is used. `python -m backend.db --pull-live` copies live data down.
DATABASE_URL=

# Local only: set to 1 to let this machine call Spotify/YouTube/Instagram.
# Off by default because those calls spend the live site's free allowance.
LIVE_APIS=

# Instagram (Meta Business Discovery). Run `python -m backend.instagram --setup`
# once with META_APP_ID / META_APP_SECRET / IG_SETUP_TOKEN set; it writes
# IG_USER_ID and IG_ACCESS_TOKEN here. Only those two go on Render.
META_APP_ID=
META_APP_SECRET=
IG_SETUP_TOKEN=
IG_USER_ID=
IG_ACCESS_TOKEN=
