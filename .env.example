# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Spotify — create an app at https://developer.spotify.com/dashboard
# (Client Credentials flow; no redirect URI needed for public artist data)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
# Optional: leave blank to skip YouTube stats.
YOUTUBE_API_KEY=

# Optional: protects POST /api/refresh in production. If blank, refresh is
# allowed from localhost only (fine for local dev).
ADMIN_TOKEN=

# Kit newsletter (kit.com). Signup form adds emails to your Kit list.
KIT_API_KEY=
KIT_FORM_ID=
